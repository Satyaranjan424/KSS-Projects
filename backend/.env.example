PROJECT_NAME="KALPANAAA Software Solutions - Projects API"
VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=True

SUPABASE_URL=https://your-project-id.supabase.co

SUPABASE_ANON_KEY=your-supabase-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

SUPABASE_JWT_SECRET=your-supabase-jwt-secret

STORAGE_BUCKET_NAME=company-project-assets

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=kalpanaam/projects

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://your-frontend.vercel.app"]

# Admin Password Protection
# Generate hash: python -c "import bcrypt; print(bcrypt.hashpw(b'YourPassword', bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH=your-bcrypt-hashed-admin-password
# Generate secret: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SESSION_SECRET=your-32-byte-random-hex-secret
ADMIN_SESSION_DURATION=900

